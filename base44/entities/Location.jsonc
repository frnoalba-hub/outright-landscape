{
  "name": "Location",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "City name (e.g. Covina)"
    },
    "slug": {
      "type": "string",
      "description": "URL slug (e.g. covina, west-covina)"
    },
    "intro": {
      "type": "string",
      "description": "Introductory text for the location page"
    },
    "mapUrl": {
      "type": "string",
      "description": "Google Maps Embed URL"
    },
    "geo": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        }
      }
    },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "a": {
            "type": "string"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "iconName": {
            "type": "string"
          },
          "keywords": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "slug"
  ]
}